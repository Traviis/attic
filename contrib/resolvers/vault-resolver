#!/usr/bin/env python3
"""Resolve public attribution keys from operator-controlled Vault namespaces."""

import base64
import json
import os
import re
import sys
import urllib.error
import urllib.request


class Vault:
    def __init__(self):
        self.address = os.environ["VAULT_ADDR"].rstrip("/")
        self.headers = {"X-Vault-Token": os.environ["VAULT_TOKEN"]}
        if os.environ.get("VAULT_NAMESPACE"):
            self.headers["X-Vault-Namespace"] = os.environ["VAULT_NAMESPACE"]

    def read(self, path, listing=False):
        request = urllib.request.Request(
            self.address + "/v1/" + path + ("?list=true" if listing else ""),
            headers=self.headers,
        )
        try:
            with urllib.request.urlopen(request, timeout=5) as response:
                return json.load(response)["data"]
        except urllib.error.HTTPError as error:
            if error.code == 404:
                return {"keys": []} if listing else None
            raise


def component(value):
    if not isinstance(value, str) or not re.fullmatch(
        r"[A-Za-z0-9][A-Za-z0-9_-]*", value
    ):
        raise ValueError("invalid registry path component")
    return value


def public_key(value):
    name, payload = value.split(":", 1)
    if len(base64.b64decode(payload, validate=True)) != 32:
        raise ValueError("invalid public key")
    return name


def transit_entries(identity, data):
    if not data or data.get("type") != "ed25519":
        return []
    if any(
        data.get(flag)
        for flag in ("exportable", "allow_plaintext_backup", "imported_key")
    ):
        print("Skipping unsafe transit key", file=sys.stderr)
        return []
    entries = []
    for version, key in data["keys"].items():
        if key.get("imported_key") or key.get("imported"):
            print("Skipping unsafe transit key version", file=sys.stderr)
            continue
        if not re.fullmatch(r"[1-9][0-9]*", version):
            raise ValueError("invalid transit key version")
        value = f"{identity}-vault-{version}:{key['public_key']}"
        public_key(value)
        entry = {
            "publicKey": value,
            "metadata": {"identity": identity, "kind": "vault"},
        }
        if key.get("creation_time"):
            entry["validFrom"] = key["creation_time"]
        entries.append(entry)
    return entries


def registered_entry(identity, location, data):
    value = data["publicKey"]
    name = public_key(value)
    if location[0] == "svc":
        service = component(location[1])
        label = component(location[-1])
        if not re.fullmatch(re.escape(service + "-" + label) + r"-[1-9][0-9]*", name):
            raise ValueError("service key name does not match registry location")
        kind, owner = "service", "svc/" + service
    else:
        host = component(location[-1])
        if not re.fullmatch(re.escape(identity + "-" + host) + r"-[1-9][0-9]*", name):
            raise ValueError("host key name does not match registry location")
        kind, owner = "host", identity
    entry = {"publicKey": value, "metadata": {"identity": owner, "kind": kind}}
    for field in ("validFrom", "validUntil", "revoked"):
        if field in data:
            entry[field] = data[field]
    return entry


def resolve(vault):
    entries = []
    for name in vault.read("transit/keys", listing=True)["keys"]:
        if name.startswith("nix-"):
            identity = component(name[4:])
            entries.extend(
                transit_entries(identity, vault.read("transit/keys/" + name))
            )

    def walk(parts):
        path = "/".join(parts)
        for name in vault.read("secret/metadata/nix-keys/" + path, listing=True)[
            "keys"
        ]:
            if name.endswith("/"):
                walk(parts + [component(name[:-1])])
                continue
            leaf = component(name)
            location = parts + [leaf]
            if len(location) == 3 and location[0] != "svc" and location[1] == "hosts":
                identity = component(location[0])
            elif len(location) == 3 and location[0] == "svc":
                identity = component(location[1])
            else:
                raise ValueError("unsupported registry location")
            record = vault.read("secret/data/nix-keys/" + "/".join(location))
            if record is not None:
                entries.append(registered_entry(identity, location, record["data"]))

    walk([])
    return {"version": 1, "keys": entries}


if __name__ == "__main__":
    try:
        json.dump(resolve(Vault()), sys.stdout)
        sys.stdout.write("\n")
    except (KeyError, ValueError, TypeError, OSError, urllib.error.URLError):
        print("Vault registry resolution failed", file=sys.stderr)
        sys.exit(1)
