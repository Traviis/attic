#!/usr/bin/env python3
"""Minimal Attic signing protocol example using a Nix Ed25519 key and OpenSSL."""

import base64
import json
import os
import subprocess
import sys
import tempfile


def sign(request, key_file):
    if request.get("version") != 1:
        raise ValueError("unsupported signing version")
    with open(key_file) as source:
        name, encoded = source.read().strip().split(":", 1)
    key = base64.b64decode(encoded, validate=True)
    if not name or len(key) != 64:
        raise ValueError("invalid Nix secret key")
    signatures = []
    with tempfile.TemporaryDirectory(prefix="attic-signer-") as directory:
        key_path = os.path.join(directory, "key.der")
        descriptor = os.open(key_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "wb") as secret:
            secret.write(bytes.fromhex("302e020100300506032b657004220420") + key[:32])
        message_path = os.path.join(directory, "message")
        for path in request["paths"]:
            with open(message_path, "wb") as message:
                message.write(path["fingerprint"].encode())
            result = subprocess.run(
                [
                    "openssl",
                    "pkeyutl",
                    "-sign",
                    "-rawin",
                    "-keyform",
                    "DER",
                    "-inkey",
                    key_path,
                    "-in",
                    message_path,
                ],
                capture_output=True,
                timeout=30,
                check=True,
            )
            if result.stderr or len(result.stdout) != 64:
                raise ValueError("unexpected OpenSSL result")
            signatures.append(name + ":" + base64.b64encode(result.stdout).decode())
    return {"signatures": signatures}


if __name__ == "__main__":
    try:
        if len(sys.argv) != 2:
            raise ValueError("usage: keyfile-signer KEY_FILE")
        json.dump(sign(json.load(sys.stdin), sys.argv[1]), sys.stdout)
        sys.stdout.write("\n")
    except (KeyError, ValueError, TypeError, OSError, subprocess.SubprocessError):
        print("Key-file signing failed", file=sys.stderr)
        sys.exit(1)
